#!/bin/sh
# 커밋마다 버전(x.y.z)의 patch(z)를 자동 +1 한다.
# 버전 위치: pyproject.toml 의 `version = "x.y.z"`, 없으면 저장소 루트 VERSION 파일(한 줄 x.y.z).
# 이번 커밋에서 minor(y) 또는 major(x)가 직전 커밋보다 이미 올라갔으면
# (대개편·릴리즈로 사람이 올리고 patch를 0으로 리셋한 경우) 건드리지 않는다.
# 활성화(로컬 저장소마다 1회): git config core.hooksPath scripts/hooks

set -e

# 현황판 갱신: 워크스페이스 생성기가 있으면 이 프로젝트의 docs/현황.md, 프로젝트현황.html(폴더 최상단) 을
# 지금 상태로 다시 만들어 이 커밋에 넣는다 (바뀐 게 없으면 파일을 건드리지 않음).
# 생성기가 없거나 실패해도 커밋은 막지 않는다. 정본: develop/2.Tools/project-status/README.md
STATUS_GEN="../2.Tools/project-status/generate_status.py"
if [ -f "$STATUS_GEN" ]; then
    PY=$(command -v python || command -v python3 || command -v py || true)
    if [ -n "$PY" ] && "$PY" -X utf8 -B "$STATUS_GEN" --only . --quiet; then
        for f in docs/현황.md 프로젝트현황.html; do
            [ -f "$f" ] && git add -- "$f"
        done
    else
        echo "pre-commit: 현황판 갱신 실패 — 커밋은 계속함" >&2
    fi
fi

if [ -f pyproject.toml ] && grep -q '^version = "[0-9]*\.[0-9]*\.[0-9]*"' pyproject.toml; then
    FILE="pyproject.toml"
    read_version() { grep -m1 '^version = "' | sed -E 's/^version = "([0-9]+\.[0-9]+\.[0-9]+)".*/\1/'; }
elif [ -f VERSION ]; then
    FILE="VERSION"
    read_version() { grep -m1 -E '^[0-9]+\.[0-9]+\.[0-9]+' | sed -E 's/^([0-9]+\.[0-9]+\.[0-9]+).*/\1/'; }
else
    exit 0
fi

CUR_VERSION=$(read_version < "$FILE")
if [ -z "$CUR_VERSION" ]; then
    exit 0
fi

PREV_VERSION=$(git show HEAD:"$FILE" 2>/dev/null | read_version || true)

CUR_MAJOR=$(echo "$CUR_VERSION" | cut -d. -f1)
CUR_MINOR=$(echo "$CUR_VERSION" | cut -d. -f2)
CUR_PATCH=$(echo "$CUR_VERSION" | cut -d. -f3)

if [ -n "$PREV_VERSION" ]; then
    PREV_MAJOR=$(echo "$PREV_VERSION" | cut -d. -f1)
    PREV_MINOR=$(echo "$PREV_VERSION" | cut -d. -f2)

    if [ "$CUR_MAJOR" != "$PREV_MAJOR" ] || [ "$CUR_MINOR" != "$PREV_MINOR" ]; then
        # major/minor가 이미 상승했다 — 사람이 명시적으로 개정한 것이므로 patch는 안 건드린다.
        exit 0
    fi
fi

NEW_VERSION="${CUR_MAJOR}.${CUR_MINOR}.$((CUR_PATCH + 1))"

if [ "$FILE" = "pyproject.toml" ]; then
    sed -i -E "s/^version = \"${CUR_VERSION}\"/version = \"${NEW_VERSION}\"/" "$FILE"
else
    printf '%s\n' "$NEW_VERSION" > "$FILE"
fi
git add "$FILE"

echo "pre-commit: ${FILE} version ${CUR_VERSION} -> ${NEW_VERSION}"
